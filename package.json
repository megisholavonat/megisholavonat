{
    "name": "mhonorepo",
    "private": true,
    "scripts": {
        "dev": "turbo dev",
        "check": "turbo check",
        "test": "turbo test",
        "generate:schema": "pnpm --filter api run generate-openapi",
        "generate:client": "pnpm --filter api-client run generate",
        "generate:api": "pnpm generate:schema && pnpm generate:client",
        "db:migrate": "pnpm --filter @megisholavonat/api db:migrate"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.11",
        "turbo": "2.9.18"
    },
    "packageManager": "pnpm@10.33.0",
    "pnpm": {
        "overrides": {
            "lightningcss": "1.30.1",
            "@hey-api/json-schema-ref-parser>js-yaml": "^4.3.2",
            "@tailwindcss/typography>postcss-selector-parser": "^6.1.5"
        },
        "onlyBuiltDependencies": [
            "@swc/core",
            "core-js",
            "sharp"
        ]
    }
}
