{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "env": ["SKIP_*"],
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".next/**"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "check": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "e2e": {
            "dependsOn": ["build"],
            "env": ["CI", "E2E_*", "PLAYWRIGHT_*"],
            "passThroughEnv": ["HOME"],
            "cache": false
        }
    }
}
