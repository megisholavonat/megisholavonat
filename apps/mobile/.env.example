# Copy to apps/mobile/.env for local development. Metro inlines these into
# the JS bundle it serves, so restart `pnpm dev --clear` after a change.
# Unset, both default to production (see src/config.ts). Development builds
# show the API in use at the bottom of Settings.

# The API base, without a trailing slash. For a local API (apps/api on :8000)
# use an address the phone can reach, not localhost (that is the phone).
#
# Over Tailscale, serve the API with HTTPS on this machine's ts.net name:
#   tailscale serve --bg 8000
# and use the https URL it prints. iOS App Transport Security refuses plain
# http to a ts.net name ("requires the use of a secure connection"); the
# ts.net certificate is a real one, so no exception is needed.
# Stop it again with `tailscale serve reset`.
EXPO_PUBLIC_API_URL=https://my-laptop.tailnet-name.ts.net

# Or, on the same Wi-Fi, this machine's LAN address:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# OpenRailwayMap tile cache; production by default.
# EXPO_PUBLIC_TILE_CACHE_URL=https://tc.megisholavonat.info
