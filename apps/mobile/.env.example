# Copy to apps/mobile/.env for local development. Both default to production
# when unset (see src/config.ts).

# The local API (apps/api on :8000) at this machine's LAN address, so a phone
# on the same network can reach it. Not localhost: that is the phone itself.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# EXPO_PUBLIC_TILE_CACHE_URL=https://tc.megisholavonat.info
