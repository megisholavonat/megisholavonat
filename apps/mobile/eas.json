{
    "cli": {
        "version": ">= 27.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "base": {
            "pnpm": "10.33.0"
        },
        "development": {
            "extends": "base",
            "developmentClient": true,
            "distribution": "internal",
            "environment": "development"
        },
        "development-simulator": {
            "extends": "development",
            "ios": {
                "simulator": true
            }
        },
        "preview": {
            "extends": "base",
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://megisholavonat.info/api",
                "EXPO_PUBLIC_TILE_CACHE_URL": "https://tc.megisholavonat.info"
            }
        },
        "beta": {
            "extends": "base",
            "distribution": "store",
            "autoIncrement": true,
            "env": {
                "EXPO_PUBLIC_API_URL": "https://api.megisholavonat.info",
                "EXPO_PUBLIC_TILE_CACHE_URL": "https://tc.megisholavonat.info"
            }
        },
        "production": {
            "extends": "base",
            "autoIncrement": true,
            "env": {
                "EXPO_PUBLIC_API_URL": "https://api.megisholavonat.info",
                "EXPO_PUBLIC_TILE_CACHE_URL": "https://tc.megisholavonat.info"
            }
        }
    },
    "submit": {
        "beta": {
            "ios": {},
            "android": {
                "track": "internal",
                "releaseStatus": "completed"
            }
        },
        "production": {
            "android": {
                "track": "production",
                "releaseStatus": "completed"
            }
        }
    }
}
