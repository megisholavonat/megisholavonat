GRAPHQL_ENDPOINT=
DEBUG=true
REDIS_PORT=6379
REDIS_KEY=mhav-local
DATABASE_URL=postgresql+asyncpg://mhav:mhav@localhost:5432/mhav
# Serve recorded snapshots instead of calling upstream (see README)
# REPLAY_FILE=tests/fixtures/vehicles-sample.jsonl.gz
# Reverse proxies whose X-Forwarded-For is trusted (IPs/CIDRs, comma-separated).
# The Next.js dev server proxies /api from localhost.
TRUSTED_PROXIES=127.0.0.1,::1
