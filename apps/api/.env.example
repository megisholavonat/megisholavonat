GRAPHQL_ENDPOINT=
DEBUG=true
REDIS_PORT=6379
REDIS_KEY=mhav-local
DATABASE_URL=postgresql+asyncpg://mhav:mhav@localhost:5432/mhav
# Serve recorded snapshots instead of calling upstream (see README)
# REPLAY_FILE=tests/fixtures/vehicles-sample.jsonl.gz
# Reverse proxies whose X-Forwarded-For is trusted (IPs/CIDRs, comma-separated).
# The Next.js dev server proxies /api from localhost.
TRUSTED_PROXIES=127.0.0.1,::1
# Header with the client IP set by the edge (e.g. CF-Connecting-IP behind
# Cloudflare). Trusted only from TRUSTED_PROXIES; empty disables it.
CLIENT_IP_HEADER=
# Push alerts (native only). Without credentials a sender logs and sends nothing.
# EXPO_ACCESS_TOKEN=
# iOS Live Activities via APNs token auth; APNS_PRIVATE_KEY is the .p8 contents
# (newlines may be written as \n)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=
# APNS_USE_SANDBOX=false
# LIVE_ACTIVITY_PUSH_ENABLED=true
# LIVE_ACTIVITY_PUSH_TO_START_ENABLED=true
# LIVE_ACTIVITY_START_WINDOW_MIN=40
